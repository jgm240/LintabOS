# ---- LintabOS's own parts: tablet tuning, installer, BitLocker tools, updater, branding -------------
# Built from payload/ by scripts/build-deb.sh and served from config/packages.chroot; it is installed only because
# it is named here.
lintabos-core

# ---- Tablet-mode sound and helpers (Chromium for the Microsoft 365 web apps is an optional download in LintabOS Extras) ----
pipewire-bin
python3-pyudev
zenity

