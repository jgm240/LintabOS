#!/bin/sh
# SPDX-License-Identifier: MIT
# Installs Waydroid (Android in a container) from Debian backports and sets it up. Run through pkexec by lintab-extras.
set -eu
[ "$(id -u)" = 0 ] || { echo "must run as root" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
apt-get update
apt-get install -y --no-install-recommends -t trixie-backports waydroid
# The kernel's Android IPC is a module here (no binderfs): load it with the devices Waydroid wants.
modprobe binder_linux devices=binder,hwbinder,vndbinder 2>/dev/null || true
if [ ! -e /var/lib/waydroid/waydroid.cfg ]; then
    waydroid init
fi
systemctl enable --now waydroid-container.service
echo "Waydroid is installed. Open \"Waydroid\" from the app grid; the first start takes a minute."
