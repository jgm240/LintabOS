[Desktop Entry]
Type=Application
Name=LintabOS Extras
Comment=Optional downloads (Microsoft 365 web apps, drawing, office, Android, Windows apps), and removing them
Exec=lintab-extras gui
Icon=system-software-install
Categories=System;
Keywords=extras;rnote;xournal;libreoffice;waydroid;android;bottles;wine;microsoft;office;uninstall;remove;
Actions=remove;

[Desktop Action remove]
Name=Remove extras…
Exec=lintab-extras gui --remove
