# LintabOS boot splash: centered logo that gently pulses, on a dark gradient.
# Original work for LintabOS; replaces the Debian-branded splash from desktop-base.
Window.SetBackgroundTopColor(0.05, 0.09, 0.21);
Window.SetBackgroundBottomColor(0.02, 0.04, 0.11);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10);

frame = 0;
fun refresh_callback ()
  {
    frame++;
    logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(frame / 18));
  }
Plymouth.SetRefreshFunction(refresh_callback);
